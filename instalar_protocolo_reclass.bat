@echo off
setlocal EnableExtensions

rem Instalador independente: nao depende de um arquivo .ps1 separado.
set "RECLASS_APP_DIR=%~dp0"

if not exist "%~dp0abrir_reclass.bat" (
    echo ERRO: Nao encontrei abrir_reclass.bat na mesma pasta.
    echo Pasta esperada: "%~dp0"
    pause
    exit /b 1
)
if not exist "%~dp0reclass_desktop.py" (
    echo ERRO: Nao encontrei reclass_desktop.py na mesma pasta.
    echo Pasta esperada: "%~dp0"
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
    echo.
    echo Nao foi possivel registrar o protocolo reclass://.
    pause
    exit /b 1
)

echo.
pause
endlocal
